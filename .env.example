# Database & Security (Serverless API)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.vpqbqwt.mongodb.net/staybuddy?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5000

# Authentication (Frontend & Webhooks)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_cmVzb2x2ZWQtY2hpbXAtOTIuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here

