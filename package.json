{
  "name": "stay-buddy-hotel-management",
  "version": "1.0.0",
  "private": true,
  "description": "Stay Buddy - Hotel Management Platform (Fullstack Monorepo on Vercel)",
  "scripts": {
    "dev": "npm run --prefix frontend dev",
    "dev:frontend": "npm run --prefix frontend dev",
    "dev:backend": "npm run --prefix backend dev",
    "build": "npm run --prefix frontend build",
    "build:frontend": "npm run --prefix frontend build",
    "postinstall": "npm install --prefix frontend",
    "lint": "npm run --prefix frontend lint",
    "test": "npm run --prefix frontend test",
    "preview": "npm run --prefix frontend preview",
    "start": "node backend/server.js",
    "start:backend": "npm run --prefix backend start",
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0"
  }
}
